{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davinci-resolve-agent.local/contracts/editing-recipe-run.schema.json",
  "title": "DaVinci Resolve Agent editing recipe run receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["recipe_run_version", "receipt_id", "recipe_id", "recipe_version", "recipe_sha256", "status", "inputs", "steps"],
  "properties": {
    "recipe_run_version": {"const": "1.0"},
    "receipt_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "recipe_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-v[0-9]+$", "maxLength": 80},
    "recipe_version": {"const": "1.0"},
    "recipe_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["in_progress", "applied"]},
    "inputs": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {"type": ["string", "number", "boolean"]}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "action", "status", "result"],
        "properties": {
          "step_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "action": {
            "enum": [
              "compose_webcam_picture_in_picture",
              "link_synchronized_screen_pair"
            ]
          },
          "status": {"enum": ["pending", "applied"]},
          "result": {"type": ["object", "null"]}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davinci-resolve-agent.local/contracts/synchronized-link-result.schema.json",
  "title": "DaVinci Resolve Agent M40 synchronized screen link result",
  "type": "object",
  "additionalProperties": false,
  "required": ["link_version", "receipt_id", "status", "inputs", "source", "operation"],
  "properties": {
    "link_version": {"const": "1.0"},
    "receipt_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["in_progress", "applied"]},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synchronized_pair_receipt_id"],
      "properties": {
        "synchronized_pair_receipt_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeline_id", "screen_video_timeline_item_id", "screen_audio_timeline_item_id"],
      "properties": {
        "timeline_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "screen_video_timeline_item_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "screen_audio_timeline_item_id": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "status", "result"],
      "properties": {
        "operation": {"const": "set_screen_pair_linked"},
        "status": {"enum": ["pending", "applied"]},
        "result": {"type": ["object", "null"]}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "applied"}}},
      "then": {
        "properties": {
          "operation": {
            "properties": {
              "status": {"const": "applied"},
              "result": {"type": "object"}
            }
          }
        }
      }
    }
  ]
}

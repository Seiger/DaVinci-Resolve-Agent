{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davinci-resolve-agent.local/contracts/take-sequence-media-import-preview.schema.json",
  "title": "M55.4 read-only Media Pool import preview",
  "type": "object",
  "additionalProperties": false,
  "required": ["import_preview_version", "plan_id", "status", "mapping_plan_id", "binding_id", "target_timeline_id", "media_pool_snapshot_sha256", "media_pool_item_count", "media_pool_folder_count", "sources", "source_count", "collision_count", "import_ready", "requires_review", "media_pool_verified", "paths_redacted", "media_pool_modified", "timeline_modified", "apply_supported"],
  "properties": {
    "import_preview_version": {"const": "1.0"},
    "plan_id": {"$ref": "#/$defs/sha256"},
    "status": {"const": "preview"},
    "mapping_plan_id": {"$ref": "#/$defs/sha256"},
    "binding_id": {"$ref": "#/$defs/sha256"},
    "target_timeline_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "media_pool_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "media_pool_item_count": {"type": "integer", "minimum": 0, "maximum": 10000},
    "media_pool_folder_count": {"type": "integer", "minimum": 0, "maximum": 1000},
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_key", "display_name", "orders", "action", "name_matches", "name_match_count"],
        "properties": {
          "source_key": {"$ref": "#/$defs/sha256"},
          "display_name": {"type": "string", "minLength": 1, "maxLength": 255},
          "orders": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 100}},
          "action": {"enum": ["import", "review_name_collision"]},
          "name_matches": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/mediaPoolItem"}},
          "name_match_count": {"type": "integer", "minimum": 0, "maximum": 100}
        }
      }
    },
    "source_count": {"type": "integer", "minimum": 1, "maximum": 100},
    "collision_count": {"type": "integer", "minimum": 0, "maximum": 100},
    "import_ready": {"type": "boolean"},
    "requires_review": {"type": "boolean"},
    "media_pool_verified": {"const": true},
    "paths_redacted": {"const": true},
    "media_pool_modified": {"const": false},
    "timeline_modified": {"const": false},
    "apply_supported": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mediaPoolItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "name", "folder_id", "folder_path"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "name": {"type": "string", "minLength": 1, "maxLength": 255},
        "folder_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "folder_path": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"type": "string", "minLength": 1, "maxLength": 255}}
      }
    }
  }
}

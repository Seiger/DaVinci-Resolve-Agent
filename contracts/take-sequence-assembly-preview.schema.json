{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davinci-resolve-agent.local/contracts/take-sequence-assembly-preview.schema.json",
  "title": "M55.2 path-redacted take-sequence assembly preview",
  "type": "object",
  "additionalProperties": false,
  "required": ["assembly_version", "plan_id", "status", "assembly_name", "binding_id", "binding_sha256", "entries", "entry_count", "total_duration_seconds", "uniform_frame_rate", "uniform_resolution", "warnings", "paths_redacted", "timeline_modified", "apply_supported"],
  "properties": {
    "assembly_version": {"const": "1.0"},
    "plan_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "preview"},
    "assembly_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "binding_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "selected_candidate_id", "display_name", "fingerprint", "source_range", "output_range", "video"],
        "properties": {
          "order": {"type": "integer", "minimum": 1, "maximum": 100},
          "selected_candidate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "display_name": {"type": "string", "minLength": 1, "maxLength": 255},
          "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_range": {"$ref": "#/$defs/range"},
          "output_range": {"$ref": "#/$defs/range"},
          "video": {
            "type": "object",
            "additionalProperties": false,
            "required": ["frame_rate", "width", "height"],
            "properties": {
              "frame_rate": {"type": "number", "exclusiveMinimum": 0},
              "width": {"type": "integer", "minimum": 1},
              "height": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "entry_count": {"type": "integer", "minimum": 1, "maximum": 100},
    "total_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "uniform_frame_rate": {"type": "boolean"},
    "uniform_resolution": {"type": "boolean"},
    "warnings": {"type": "array", "maxItems": 2, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
    "paths_redacted": {"const": true},
    "timeline_modified": {"const": false},
    "apply_supported": {"const": false}
  },
  "$defs": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_seconds", "end_seconds"],
      "properties": {
        "start_seconds": {"type": "number", "minimum": 0},
        "end_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}

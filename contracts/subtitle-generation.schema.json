{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davinci-resolve-agent.local/contracts/subtitle-generation.schema.json",
  "title": "Generated subtitle application receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "status",
    "timeline_id",
    "source_file",
    "subtitle_file",
    "backend",
    "model",
    "language",
    "segment_count",
    "previous_subtitle_item_count",
    "subtitle_item_count",
    "timeline_item_ids",
    "import_result",
    "append_result"
  ],
  "properties": {
    "receipt_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"const": "applied"},
    "timeline_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_file": {"type": "string", "minLength": 1},
    "subtitle_file": {"type": "string", "minLength": 1},
    "backend": {"type": "string", "minLength": 1, "maxLength": 64},
    "model": {"type": "string", "minLength": 1, "maxLength": 64},
    "language": {"type": "string", "minLength": 2, "maxLength": 16},
    "segment_count": {"type": "integer", "minimum": 1, "maximum": 10000},
    "previous_subtitle_item_count": {"type": "integer", "minimum": 0},
    "subtitle_item_count": {"type": "integer", "minimum": 1},
    "timeline_item_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeline_start_frame", "append_frame", "append_frame_source", "timeline_frame_rate", "expected_first_frame", "actual_first_frame"],
      "properties": {
        "timeline_start_frame": {"type": "integer"},
        "append_frame": {"type": "integer"},
        "append_frame_source": {"enum": ["bridge", "recovered_provider_receipt"]},
        "timeline_frame_rate": {"type": "number", "exclusiveMinimum": 0},
        "expected_first_frame": {"type": "integer"},
        "actual_first_frame": {"type": "integer"}
      }
    },
    "import_result": {"type": "object"},
    "append_result": {"type": "object"}
  }
}

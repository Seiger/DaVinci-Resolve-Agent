{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davinci-resolve-agent.local/contracts/take-sequence-timeline-preview.schema.json",
  "title": "M55.3 live timeline frame-mapping preview",
  "type": "object",
  "additionalProperties": false,
  "required": ["mapping_version", "plan_id", "status", "assembly_plan_id", "binding_id", "target_timeline", "placements", "placement_count", "output_duration_frames", "output_duration_seconds", "warnings", "live_metadata_verified", "paths_redacted", "timeline_modified", "apply_supported"],
  "properties": {
    "mapping_version": {"const": "1.0"},
    "plan_id": {"$ref": "#/$defs/sha256"},
    "status": {"const": "preview"},
    "assembly_plan_id": {"$ref": "#/$defs/sha256"},
    "binding_id": {"$ref": "#/$defs/sha256"},
    "target_timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeline_id", "name", "frame_rate", "resolution_width", "resolution_height", "video_track_count", "audio_track_count"],
      "properties": {
        "timeline_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "frame_rate": {"type": "number", "exclusiveMinimum": 0},
        "resolution_width": {"type": "integer", "minimum": 1},
        "resolution_height": {"type": "integer", "minimum": 1},
        "video_track_count": {"type": "integer", "minimum": 0},
        "audio_track_count": {"type": "integer", "minimum": 0}
      }
    },
    "placements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "selected_candidate_id", "display_name", "fingerprint", "source_frame_rate", "source_start_frame", "source_end_frame", "source_duration_frames", "position_frames", "timeline_duration_frames", "timeline_end_position_frames"],
        "properties": {
          "order": {"type": "integer", "minimum": 1, "maximum": 100},
          "selected_candidate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "display_name": {"type": "string", "minLength": 1, "maxLength": 255},
          "fingerprint": {"$ref": "#/$defs/sha256"},
          "source_frame_rate": {"type": "number", "exclusiveMinimum": 0},
          "source_start_frame": {"$ref": "#/$defs/frame"},
          "source_end_frame": {"$ref": "#/$defs/frame"},
          "source_duration_frames": {"type": "integer", "minimum": 1, "maximum": 2147483647},
          "position_frames": {"$ref": "#/$defs/frame"},
          "timeline_duration_frames": {"type": "integer", "minimum": 1, "maximum": 2147483647},
          "timeline_end_position_frames": {"type": "integer", "minimum": 1, "maximum": 2147483647}
        }
      }
    },
    "placement_count": {"type": "integer", "minimum": 1, "maximum": 100},
    "output_duration_frames": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "output_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "warnings": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
    "live_metadata_verified": {"const": true},
    "paths_redacted": {"const": true},
    "timeline_modified": {"const": false},
    "apply_supported": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "frame": {"type": "integer", "minimum": 0, "maximum": 2147483647}
  }
}

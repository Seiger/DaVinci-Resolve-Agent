{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davinci-resolve-agent.local/contracts/visual-treatment-result.schema.json",
  "title": "DaVinci Resolve Agent M49 visual treatment receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["visual_treatment_version", "receipt_id", "status", "inputs", "operations"],
  "properties": {
    "visual_treatment_version": {"const": "1.0"},
    "receipt_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["in_progress", "applied"]},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeline_id", "transforms", "titles"],
      "properties": {
        "timeline_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "transforms": {
          "type": "array", "maxItems": 1001,
          "items": {"$ref": "#/$defs/transform"}
        },
        "titles": {
          "type": "array", "maxItems": 100,
          "items": {"$ref": "#/$defs/title"}
        }
      }
    },
    "operations": {
      "type": "array", "minItems": 1, "maxItems": 101,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "status", "result"],
        "properties": {
          "kind": {"enum": ["set_clip_transforms", "insert_title"]},
          "status": {"enum": ["pending", "applied"]},
          "title_index": {"type": "integer", "minimum": 0, "maximum": 99},
          "result": {"type": ["object", "null"]}
        }
      }
    }
  },
  "$defs": {
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeline_item_id"],
      "properties": {
        "timeline_item_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "position_x": {"type": "number", "minimum": -32768, "maximum": 32768},
        "position_y": {"type": "number", "minimum": -32768, "maximum": 32768},
        "zoom": {"type": "number", "minimum": 0, "maximum": 100},
        "rotation_degrees": {"type": "number", "minimum": -360, "maximum": 360},
        "opacity_percent": {"type": "number", "minimum": 0, "maximum": 100}
      },
      "anyOf": [
        {"required": ["position_x"]}, {"required": ["position_y"]},
        {"required": ["zoom"]}, {"required": ["rotation_degrees"]},
        {"required": ["opacity_percent"]}
      ]
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title_name", "timecode"],
      "properties": {
        "title_name": {"type": "string", "minLength": 1, "maxLength": 128},
        "timecode": {"type": "string", "pattern": "^[0-9]{2,3}:[0-9]{2}:[0-9]{2}:[0-9]{2}$"}
      }
    }
  }
}

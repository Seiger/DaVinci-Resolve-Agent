{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davinci-resolve-agent.local/contracts/command.schema.json",
  "title": "DaVinci Resolve Agent command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "command_id",
    "idempotency_key",
    "created_at",
    "expires_at",
    "provider",
    "action",
    "arguments",
    "safety"
  ],
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "command_id": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider": {
      "const": "resolve"
    },
    "action": {
      "enum": [
        "ping",
        "get_bridge_info",
        "get_capabilities",
        "get_current_project",
        "list_timelines",
        "get_current_timeline",
        "get_render_environment",
        "import_media",
        "create_timeline",
        "append_clip",
        "add_marker",
        "prepare_render_job"
      ]
    },
    "arguments": {
      "type": "object"
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_destructive",
        "create_backup"
      ],
      "properties": {
        "allow_destructive": {
          "const": false
        },
        "create_backup": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "prepare_render_job"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "additionalProperties": false,
            "required": [
              "custom_name"
            ],
            "properties": {
              "custom_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "ping",
              "get_bridge_info",
              "get_capabilities",
              "get_current_project",
              "list_timelines",
              "get_current_timeline",
              "get_render_environment"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "maxProperties": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "import_media"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "additionalProperties": false,
            "required": [
              "paths"
            ],
            "properties": {
              "paths": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "create_timeline"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "append_clip"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "additionalProperties": false,
            "required": [
              "timeline_id",
              "asset_id"
            ],
            "properties": {
              "timeline_id": {
                "type": "string",
                "minLength": 1
              },
              "asset_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "add_marker"
          }
        }
      },
      "then": {
        "properties": {
          "arguments": {
            "additionalProperties": false,
            "required": [
              "timeline_id",
              "frame",
              "color",
              "name",
              "note",
              "duration"
            ],
            "properties": {
              "timeline_id": {
                "type": "string",
                "minLength": 1
              },
              "frame": {
                "type": "integer",
                "minimum": 0
              },
              "color": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "name": {
                "type": "string",
                "maxLength": 256
              },
              "note": {
                "type": "string",
                "maxLength": 4096
              },
              "duration": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "import_media",
              "create_timeline",
              "append_clip",
              "add_marker",
              "prepare_render_job"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "safety": {
            "properties": {
              "create_backup": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}

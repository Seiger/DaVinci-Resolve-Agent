{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davinci-resolve-agent.local/contracts/take-selection.schema.json",
  "title": "M54 technical take selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["selection_version", "selection_id", "status", "selection_name", "policy", "candidates", "recommendation", "review_required"],
  "properties": {
    "selection_version": {"enum": ["1.0", "1.1", "1.2"]},
    "selection_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "pending_review"},
    "selection_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "token_count"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "token_count": {"type": "integer", "minimum": 1}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "sampling", "weights"],
      "properties": {
        "policy_id": {"enum": ["technical-take-v1", "script-aware-take-v1"]},
        "sampling": {"type": "object"},
        "weights": {"type": "object"}
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "display_name", "fingerprint", "size_bytes", "duration_seconds", "video", "audio", "technical_score", "rank", "strengths", "warnings"],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "display_name": {"type": "string", "minLength": 1, "maxLength": 255},
          "source_range": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start_seconds", "end_seconds"],
            "properties": {
              "start_seconds": {"type": "number", "minimum": 0},
              "end_seconds": {"type": "number", "exclusiveMinimum": 0}
            }
          },
          "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 1},
          "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
          "video": {"type": "object"},
          "audio": {"type": "object"},
          "technical_score": {"type": "number", "minimum": 0, "maximum": 100},
          "selection_score": {"type": "number", "minimum": 0, "maximum": 100},
          "dialogue": {
            "type": "object",
            "additionalProperties": false,
            "required": ["backend", "model", "language", "language_probability", "transcript_sha256", "word_count", "speech_duration_seconds", "speech_coverage", "reference_precision", "reference_recall", "reference_f1"],
            "properties": {
              "backend": {"type": "string", "minLength": 1},
              "model": {"type": "string", "minLength": 1},
              "language": {"type": "string", "minLength": 1},
              "language_probability": {"type": "number", "minimum": 0, "maximum": 1},
              "transcript_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "word_count": {"type": "integer", "minimum": 1},
              "speech_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
              "speech_coverage": {"type": "number", "minimum": 0, "maximum": 1},
              "reference_precision": {"type": "number", "minimum": 0, "maximum": 1},
              "reference_recall": {"type": "number", "minimum": 0, "maximum": 1},
              "reference_f1": {"type": "number", "minimum": 0, "maximum": 1}
            }
          },
          "rank": {"type": "integer", "minimum": 1, "maximum": 8},
          "strengths": {"type": "array", "maxItems": 8, "items": {"type": "string"}},
          "warnings": {"type": "array", "maxItems": 8, "items": {"type": "string"}}
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "confidence", "score_gap", "basis", "limitations"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "confidence": {"enum": ["low", "medium", "high"]},
        "score_gap": {"type": "number", "minimum": 0, "maximum": 100},
        "basis": {"enum": ["bounded technical measurements only", "bounded technical and transcript measurements"]},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "review_required": {"const": true}
  },
  "allOf": [
    {
      "if": {"properties": {"selection_version": {"const": "1.1"}}},
      "then": {
        "properties": {
          "candidates": {
            "items": {"required": ["source_range"]}
          }
        }
      }
    },
    {
      "if": {"properties": {"selection_version": {"const": "1.2"}}},
      "then": {
        "required": ["reference"],
        "properties": {
          "policy": {"properties": {"policy_id": {"const": "script-aware-take-v1"}}},
          "candidates": {
            "items": {"required": ["source_range", "selection_score", "dialogue"]}
          },
          "recommendation": {
            "properties": {
              "basis": {"const": "bounded technical and transcript measurements"}
            }
          }
        }
      }
    }
  ]
}

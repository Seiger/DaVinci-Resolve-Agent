{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davinci-resolve-agent.local/contracts/rough-cut-apply-result.schema.json",
  "title": "DaVinci Resolve Agent M34 rough-cut apply result",
  "type": "object",
  "additionalProperties": false,
  "required": ["apply_version", "plan_id", "plan_sha256", "source_timeline_id", "target_timeline_name", "status", "preview", "unsupported_capabilities", "unsupported_operations", "operations"],
  "properties": {
    "apply_version": {"const": "1.0"},
    "plan_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_timeline_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "target_timeline_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "status": {"enum": ["preview", "blocked", "applied"]},
    "preview": {"type": "boolean"},
    "unsupported_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "unsupported_operations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "operations": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["operation", "status"], "properties": {"operation": {"type": "string"}, "status": {"enum": ["planned", "blocked", "applied"]}, "result": {"type": ["object", "null"]}}}},
    "receipt_id": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davinci-resolve-agent.local/contracts/animation-template-preview.schema.json",
  "title": "M52 animation-template preview",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "animation_plan_version",
    "plan_id",
    "status",
    "apply_supported",
    "inputs",
    "source",
    "template",
    "environment",
    "required_capabilities",
    "unsupported_capabilities"
  ],
  "properties": {
    "animation_plan_version": {"const": "1.0"},
    "plan_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "preview"},
    "apply_supported": {"type": "boolean"},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["broll_receipt_id", "target_timeline_name", "template_id", "timecode"],
      "properties": {
        "broll_receipt_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "target_timeline_name": {"type": "string", "minLength": 1, "maxLength": 128},
        "template_id": {"const": "accent-card-v1"},
        "timecode": {"type": "string", "pattern": "^[0-9]{2,3}:[0-9]{2}:[0-9]{2}:[0-9]{2}$"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeline_id", "timeline_name", "item_count", "snapshot_sha256"],
      "properties": {
        "timeline_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "timeline_name": {"type": "string", "minLength": 1, "maxLength": 128},
        "item_count": {"type": "integer", "minimum": 1},
        "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "template": {"type": "object"},
    "environment": {"type": "object"},
    "required_capabilities": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "unsupported_capabilities": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davinci-resolve-agent.local/contracts/take-sequence.schema.json",
  "title": "M54.4 approved take sequence",
  "type": "object",
  "additionalProperties": false,
  "required": ["sequence_version", "sequence_id", "status", "sequence_name", "entries", "total_duration_seconds", "timeline_modified", "apply_supported"],
  "properties": {
    "sequence_version": {"const": "1.0"},
    "sequence_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "approved_plan"},
    "sequence_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "selection_id", "selection_sha256", "review_id", "review_sha256", "selected_candidate_id", "display_name", "fingerprint", "size_bytes", "duration_seconds", "technical_score"],
        "properties": {
          "order": {"type": "integer", "minimum": 1, "maximum": 100},
          "selection_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "selection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "review_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "review_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "selected_candidate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "display_name": {"type": "string", "minLength": 1, "maxLength": 255},
          "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 1},
          "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
          "source_range": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start_seconds", "end_seconds"],
            "properties": {
              "start_seconds": {"type": "number", "minimum": 0},
              "end_seconds": {"type": "number", "exclusiveMinimum": 0}
            }
          },
          "technical_score": {"type": "number", "minimum": 0, "maximum": 100},
          "selection_score": {"type": "number", "minimum": 0, "maximum": 100},
          "dialogue": {
            "type": "object",
            "additionalProperties": false,
            "required": ["language", "transcript_sha256", "reference_f1", "speech_coverage"],
            "properties": {
              "language": {"type": "string", "minLength": 1},
              "transcript_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "reference_f1": {"type": "number", "minimum": 0, "maximum": 1},
              "speech_coverage": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        }
      }
    },
    "total_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "timeline_modified": {"const": false},
    "apply_supported": {"const": false}
  }
}

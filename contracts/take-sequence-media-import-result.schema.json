{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davinci-resolve-agent.local/contracts/take-sequence-media-import-result.schema.json",
  "title": "M55.5 confirmed Media Pool import result",
  "type": "object",
  "additionalProperties": false,
  "required": ["import_version", "receipt_id", "status", "plan_id", "mapping_plan_id", "binding_id", "assembly_name", "target_timeline_id", "media_pool_before_sha256", "media_pool_after_sha256", "sources", "source_count", "backup_created", "paths_redacted", "media_pool_modified", "timeline_modified", "apply_supported"],
  "properties": {
    "import_version": {"const": "1.0"},
    "receipt_id": {"$ref": "#/$defs/sha256"},
    "status": {"const": "applied"},
    "plan_id": {"$ref": "#/$defs/sha256"},
    "mapping_plan_id": {"$ref": "#/$defs/sha256"},
    "binding_id": {"$ref": "#/$defs/sha256"},
    "assembly_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "target_timeline_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "media_pool_before_sha256": {"$ref": "#/$defs/sha256"},
    "media_pool_after_sha256": {"$ref": "#/$defs/sha256"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_key", "display_name", "orders", "asset_id", "duration_frames", "frame_rate"],
        "properties": {
          "source_key": {"$ref": "#/$defs/sha256"},
          "display_name": {"type": "string", "minLength": 1, "maxLength": 255},
          "orders": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 100}},
          "asset_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "duration_frames": {"type": "integer", "minimum": 1, "maximum": 2147483647},
          "frame_rate": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "source_count": {"type": "integer", "minimum": 1, "maximum": 100},
    "backup_created": {"const": true},
    "paths_redacted": {"const": true},
    "media_pool_modified": {"const": true},
    "timeline_modified": {"const": false},
    "apply_supported": {"const": true}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

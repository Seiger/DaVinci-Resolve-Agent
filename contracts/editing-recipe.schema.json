{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davinci-resolve-agent.local/contracts/editing-recipe.schema.json",
  "title": "DaVinci Resolve Agent declarative editing recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["recipe_version", "recipe_id", "name", "description", "inputs", "steps"],
  "properties": {
    "recipe_version": {"const": "1.0"},
    "recipe_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-v[0-9]+$", "maxLength": 80},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string", "minLength": 1, "maxLength": 500},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "required"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "kind": {"enum": ["receipt_id", "number", "string", "boolean"]},
          "required": {"type": "boolean"},
          "default": {"type": ["string", "number", "boolean"]},
          "minimum": {"type": "number"},
          "maximum": {"type": "number"}
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "action", "required_capabilities"],
        "properties": {
          "step_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "action": {
            "enum": [
              "compose_webcam_picture_in_picture",
              "link_synchronized_screen_pair"
            ]
          },
          "required_capabilities": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z]+(?:[._][a-z]+)+$", "maxLength": 80}
          }
        }
      }
    }
  }
}
